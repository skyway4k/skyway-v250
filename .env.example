# Copy to .env for local dev (do NOT commit .env), or set as environment variables / secrets
# in your host's dashboard (Render/Fly/Railway/etc). NONE of these have hardcoded fallbacks in
# server.js — if OSKY_ID, OSKY_SECRET, SWIM_USER, SWIM_PASS, SWIM_QUEUE, or DATABASE_URL is
# missing, the server refuses to boot instead of silently running degraded or on a bundled key.
# That's deliberate: a bundled fallback key is exactly what turned into the $580 FlightAware
# bill on v249 (FA_KEY had a hardcoded default; so did OSKY_SECRET and SWIM_PASS, though only
# FlightAware had no daily cap).

PORT=8766

# --- Postgres — shared backend for pax / spot / flags / tow notes across all 3 views ---
# Free options: Render's own Postgres (render.yaml below wires this up automatically), Neon,
# or Supabase. Local dev: postgres://user:pass@localhost:5432/skyway
DATABASE_URL=

# --- OpenSky Network (ADS-B live positions) — REQUIRED, free ---
# OAuth2 client-credentials app: https://opensky-network.org/apidoc/rest.html#authentication
# Authenticated tier = 4000 credits/day. Without valid creds the server logs a warning and
# falls back to the anonymous tier (400 credits/day) rather than refusing outright, but you
# still must SET the vars (even to a value that fails auth) to pass the boot check — the point
# is no bundled key ships in the source, not that auth is optional.
OSKY_ID=
OSKY_SECRET=

# --- FAA SWIM SCDS (free arrival/departure event feed) — REQUIRED, free ---
# SBS/SWIM Cloud Distribution Service enrollment: https://swim.faa.gov
# This is now the PRIMARY arrival/departure source (FlightAware is gone). It gives near-real-time
# event pings (callsign, origin/dest, aircraft type) but — unlike FlightAware's schedule API — it
# won't show a flight that hasn't triggered an event yet, so you lose FA's "scheduled to arrive
# in 3 hours" advance visibility unless AeroDataBox is enabled below.
SWIM_USER=
SWIM_PASS=
SWIM_QUEUE=

# --- AeroDataBox (RapidAPI) — OPTIONAL, OFF by default, hard-capped ---
# Only turn this on if SWIM + OpenSky are leaving real gaps (missing aircraft type/operator).
# It's called PER FLIGHT to fill a specific gap, never for the whole board, and stops itself at
# 95% of ADB_MONTHLY_UNIT_BUDGET regardless of what your RapidAPI plan's own limit is.
ADB_ENABLED=0
ADB_KEY=
ADB_HOST=aerodatabox.p.rapidapi.com
# Must match your actual RapidAPI plan's monthly unit quota:
#   Basic(free)=600  Pro=6000  Pro2=24000  Ultra=60000  Ultra2=240000  Mega=600000
ADB_MONTHLY_UNIT_BUDGET=600

# --- Safeguards ---
# Minutes of zero connected browser tabs (WebSocket clients) before background polling
# (OpenSky schedule poll, AeroDataBox lookups) pauses itself. SWIM stays connected regardless —
# it's free and event-driven, not per-call metered, so there's no cost to leaving it up.
IDLE_PAUSE_MINUTES=10

# Conservative daily cap on OpenSky's /flights/arrival + /flights/departure calls (these aren't
# priced by the bbox-credit table OpenSky publishes for /states/all, so this is a flat safety
# net rather than a precise budget).
OSKY_FLIGHTS_DAILY_CAP=200

AIRPORT_ICAO=KSFO
